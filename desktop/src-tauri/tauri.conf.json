{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-jauge",
  "version": "0.1.0",
  "identifier": "fr.jimmybomy.claudejauge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "claude-jauge",
        "width": 320,
        "height": 250,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Jimmy Bomy",
    "copyright": "© 2026 Jimmy Bomy, MIT License",
    "category": "DeveloperTool",
    "shortDescription": "Your Claude limits at a glance",
    "longDescription": "A small widget that shows how much of your Claude Pro/Max limits is left while you use Claude Code. Local data only.",
    "homepage": "https://github.com/JimmyBomy/claude-jauge",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
